                    link.click();
                }).catch(err => {
                    console.error("Error generating certificate image:", err);
                    showMessage("Could not generate certificate image.");
                });
            } else {
                showMessage("Certificate download library or element not found.");
            }
        }

        /**
         * Generates a CSV file with the quiz results and triggers download.
         */
        function downloadResults() {
            const { date, time } = getCurrentDateTime();
            const csvHeader = "QuizDate,QuizTime,FirstName,LastName,XLC_ID,Score,TotalQuestions,Percentage,PassFail,IncorrectQuestions\n";
            const escapeCSV = (field) => `"${String(field).replace(/"/g, '""')}"`;
            const safeFirstName = escapeCSV(firstName);
            const safeLastName = escapeCSV(lastName);
            const safeXlcId = escapeCSV(xlcId);
            const incorrectQuestionsStr = escapeCSV(incorrectQuestions.join('; '));
            const csvData = `${escapeCSV(date)},${escapeCSV(time)},${safeFirstName},${safeLastName},${safeXlcId},${score},${currentShuffledQuestions.length},${percentage},${escapeCSV(passStatus)},${incorrectQuestionsStr}\n`;
            const csvContent = csvHeader + csvData;
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            if (link.download !== undefined) {
                const url = URL.createObjectURL(blob);
                link.setAttribute("href", url);
                const dateStr = date;
                link.setAttribute("download", `Forklift_Quiz_${xlcId}_${dateStr}_Result.csv`);
                link.style.visibility = 'hidden';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(url);
            } else {
                showMessage("CSV download is not supported in your browser.");
            }
        }


        // --- Core Logic Functions ---

        /**
         * Validates user input, checks attempt limits, and starts the training steps.
         */
        async function startTraining() { // Made async to handle Firestore check
            console.log("startTraining called");
            // Disable button temporarily
            if (startTrainingButton) startTrainingButton.disabled = true;

            // Ensure input elements exist
            if (!firstNameInput || !lastNameInput || !xlcIdInput) {
                showMessage("Error: Input fields could not be found.");
                console.error("Input elements missing in startTraining");
                 if (startTrainingButton) startTrainingButton.disabled = false; // Re-enable button
                return;
            }

            const fname = firstNameInput.value.trim();
            const lname = lastNameInput.value.trim();
            const id = xlcIdInput.value.trim();

            // Basic validation
            if (!fname || !lname || !id) {
                showMessage("Please fill in all fields: First Name, Last Name, and XLC_ID.");
                 if (startTrainingButton) startTrainingButton.disabled = false; // Re-enable button
                return;
            }

            // Store user details (temporarily, confirm after check)
            firstName = fname;
            lastName = lname;
            xlcId = id;

            // --- Attempt Limit Check ---
            if (typeof firestoreDb === 'undefined' || !firestoreDb) {
                showMessage("Error: Cannot connect to the database to check attempts. Please try again later.");
                console.error("Firestore not initialized in startTraining");
                 if (startTrainingButton) startTrainingButton.disabled = false; // Re-enable button
                return;
            }

            const timeLimit = getTimestampHoursAgo(ATTEMPT_WINDOW_HOURS);
            console.log(`Checking attempts for XLC_ID: ${xlcId} since ${timeLimit.toDate()}`);

            try {
                // Query Firestore for recent attempts by this user
                // NOTE: This query requires a composite index on 'xlcId' (ascending) and 'timestamp' (descending or ascending) in Firestore.
                // If you get an error in the console about needing an index, follow the link provided in the error message to create it.
                const querySnapshot = await firestoreDb.collection("quizResults")
                    .where("xlcId", "==", xlcId)
                    .where("timestamp", ">=", timeLimit)
                    // .orderBy("timestamp", "desc") // Optional: can order if needed, but just need count
                    .get();

                attemptsToday = querySnapshot.size; // Get the count of documents found
                console.log(`Found ${attemptsToday} attempts in the last ${ATTEMPT_WINDOW_HOURS} hours.`);

                if (attemptsToday >= MAX_ATTEMPTS_PER_DAY) {
                    showMessage(`You have reached the maximum of ${MAX_ATTEMPTS_PER_DAY} attempts allowed in a ${ATTEMPT_WINDOW_HOURS}-hour period. Please try again later.`);
                    if (startTrainingButton) startTrainingButton.disabled = false; // Re-enable button
                    return; // Stop execution
                }

                // --- Proceed if attempt limit not reached ---
                currentStep = 0; // Reset step counter
                console.log("User details set and attempt limit checked:", firstName, lastName, xlcId);

                // Show the training screen
                const targetScreen = document.getElementById('training-container');
                if(targetScreen){
                    console.log("Attempting to show training container...");
                    showScreen(targetScreen);
                    displayStep(currentStep); // Display the first step
                } else {
                    console.error("Training container element not found!");
                    showMessage("Error: Could not load training steps.");
                }

            } catch (error) {
                console.error("Error checking quiz attempts:", error);
                // Check if the error message indicates a missing index
                if (error.message && error.message.includes("indexes?")) {
                     showMessage(`Database configuration needed. Please ask the administrator to create the required index in Firestore for attempt checking. Details: ${error.message}`);
                } else {
                    showMessage("Error checking your previous attempts. Please try again.");
                }
                if (startTrainingButton) startTrainingButton.disabled = false; // Re-enable button
                return;
            }
             // Re-enable button if needed (e.g., if showing training screen)
             if (startTrainingButton) startTrainingButton.disabled = false;
        }

        /**
         * Displays the content for a specific training step.
         * @param {number} stepIndex The index of the step to display.
         */
        function displayStep(stepIndex) {
             if (stepIndex < 0 || stepIndex >= trainingSteps.length) return;
             if (!stepContent) { console.error("stepContent element not found!"); return; }

             const step = trainingSteps[stepIndex];
             if (!step || !step.title || !step.description || typeof step.scannerContent === 'undefined') {
                 console.error("Invalid step data for index:", stepIndex, step);
                 stepContent.innerHTML = '<p class="text-red-500">Error loading step content.</p>';
                 return;
             }

             stepIndicator.textContent = `Step ${stepIndex + 1} / ${trainingSteps.length}`;
             prevButton.disabled = stepIndex === 0;
             prevButton.classList.toggle('opacity-50', stepIndex === 0);
             prevButton.classList.toggle('cursor-not-allowed', stepIndex === 0);

             if (stepIndex === trainingSteps.length - 1) {
                 nextButton.classList.add('hidden');
                 quizButton.classList.remove('hidden');
             } else {
                 nextButton.classList.remove('hidden');
                 quizButton.classList.add('hidden');
             }

             stepContent.classList.remove('fade-in');
             void stepContent.offsetWidth;
             stepContent.classList.add('fade-in');
             stepContent.innerHTML = `
                <h2 class="text-xl md:text-2xl font-bold text-gray-800 mb-3">${step.title}</h2>
                <p class="text-gray-600 mb-4 whitespace-pre-line">${step.description}</p>
                <div class="scanner-screen">${step.scannerContent.trim()}</div>
             `;
        }

        /**
         * Moves to the next training step.
         */
        function nextStep() {
            console.log("nextStep called");
            if (currentStep < trainingSteps.length - 1) {
                currentStep++;
                displayStep(currentStep);
            }
        }

        /**
         * Moves to the previous training step.
         */
        function prevStep() {
            console.log("prevStep called");
            if (currentStep > 0) {
                currentStep--;
                displayStep(currentStep);
            }
        }

        /**
         * Initializes and starts the quiz.
         */
        function startQuiz() {
            console.log("startQuiz called");
            // Shuffle questions for variety (already implemented)
            currentShuffledQuestions = shuffleArray(originalQuizQuestions);
            // Reset quiz state
            currentQuestionIndex = 0;
            userAnswers = new Array(currentShuffledQuestions.length).fill(null);
            incorrectQuestions = [];
            score = 0;
            percentage = 0;
            passStatus = '';

            const targetScreen = document.getElementById('quiz-container');
            if (targetScreen) {
                 showScreen(targetScreen);
                 displayQuestion(currentQuestionIndex);
                 if(submitQuizButton) submitQuizButton.classList.add('hidden');
                 if(nextQuestionButton) nextQuestionButton.classList.remove('hidden');
            } else {
                 console.error("Quiz container element not found!");
                 showMessage("Error: Could not start the quiz.");
            }
        }

        /**
         * Displays a specific quiz question and its options.
         * @param {number} index The index of the question to display.
         */
        function displayQuestion(index) {
            if (index < 0 || index >= currentShuffledQuestions.length) return;
            if (!quizQuestionDiv) { console.error("quizQuestionDiv element not found!"); return; }

            const q = currentShuffledQuestions[index];
            if (!q || !q.question || !Array.isArray(q.options)) {
                console.error("Invalid question data for index:", index, q);
                quizQuestionDiv.innerHTML = '<p class="text-red-500">Error loading question.</p>';
                return;
            }

            let optionsHtml = `<p class="text-lg font-semibold mb-4">${index + 1}. ${q.question}</p><div class="space-y-3">`;
            q.options.forEach((option) => {
                const escapedOption = String(option).replace(/'/g, "\\'");
                const isSelected = userAnswers[index] === option;
                optionsHtml += `
                    <div
                        class="quiz-option border-2 border-gray-300 rounded-lg p-3 hover:bg-gray-100 ${isSelected ? 'selected' : ''}"
                        onclick="selectAnswer(${index}, '${escapedOption}')">
                        ${option}
                    </div>
                `;
            });
            optionsHtml += '</div>';
            quizQuestionDiv.innerHTML = optionsHtml;

            if(index === currentShuffledQuestions.length - 1) {
                 if(nextQuestionButton) nextQuestionButton.classList.add('hidden');
                 if(submitQuizButton) submitQuizButton.classList.remove('hidden');
            } else {
                 if(nextQuestionButton) nextQuestionButton.classList.remove('hidden');
                 if(submitQuizButton) submitQuizButton.classList.add('hidden');
            }

            quizQuestionDiv.classList.remove('fade-in');
            void quizQuestionDiv.offsetWidth;
            quizQuestionDiv.classList.add('fade-in');
        }

        /**
         * Records the user's selected answer for a question.
         * @param {number} questionIndex The index of the question.
         * @param {string} answer The selected answer text.
         */
        function selectAnswer(questionIndex, answer) {
            userAnswers[questionIndex] = answer;
            displayQuestion(questionIndex); // Re-display to show selection
        }

        /**
         * Moves to the next quiz question, validating that an answer was selected.
         */
        function nextQuestion() {
            if (userAnswers[currentQuestionIndex] === null) {
                showMessage("Please select an answer before proceeding.");
                return;
            }
            if (currentQuestionIndex < currentShuffledQuestions.length - 1) {
                currentQuestionIndex++;
                displayQuestion(currentQuestionIndex);
            }
        }

        /**
         * Calculates the quiz score, determines pass/fail status, logs results, and shows the appropriate end screen.
         */
        function submitQuiz() {
            console.log("submitQuiz called");
            if (!submitQuizButton) { console.error("Submit button not found"); return; }

            submitQuizButton.disabled = true;
            submitQuizButton.textContent = 'Submitting...';

            try {
                if (userAnswers[currentQuestionIndex] === null) {
                    showMessage("Please select an answer for the final question.");
                    submitQuizButton.disabled = false;
                    submitQuizButton.textContent = 'Submit Answers';
                    return;
                }

                score = 0;
                incorrectQuestions = [];
                userAnswers.forEach((answer, index) => {
                    if (currentShuffledQuestions[index]) {
                        if (answer === currentShuffledQuestions[index].correctAnswer) {
                            score++;
                        } else if (currentShuffledQuestions[index].question) {
                            incorrectQuestions.push(currentShuffledQuestions[index].question);
                        }
                    } else {
                        console.warn("Issue comparing answer for question index:", index, "- Question data missing.");
                    }
                });

                percentage = currentShuffledQuestions.length > 0 ? Math.round((score / currentShuffledQuestions.length) * 100) : 0;
                passStatus = percentage >= PASSING_PERCENTAGE ? 'Pass' : 'Fail';
                attemptsToday++; // Increment attempt count for this session

                console.log(`Quiz submitted: Score=${score}, Percentage=${percentage}, Status=${passStatus}, Attempt# ${attemptsToday}`);

                logQuizResult()
                    .then(() => {
                        console.log("logQuizResult finished successfully.");
                        if (passStatus === 'Pass') {
                            displayCertificate();
                        } else {
                            displayFailScreen(); // Pass the current attempt count
                        }
                    })
                    .catch(error => {
                        console.error("Error logging result to Firestore:", error);
                        showMessage("Could not save results to the database, but showing your outcome.");
                        if (passStatus === 'Pass') {
                            displayCertificate();
                        } else {
                            displayFailScreen(); // Pass the current attempt count
                        }
                    })
                    .finally(() => {
                        submitQuizButton.disabled = false;
                        submitQuizButton.textContent = 'Submit Answers';
                    });

            } catch (error) {
                console.error("Error occurred in submitQuiz function:", error);
                showMessage("An unexpected error occurred while submitting the quiz.");
                submitQuizButton.disabled = false;
                submitQuizButton.textContent = 'Submit Answers';
            }
        }


        /**
         * Displays the certificate screen with user details and date.
         */
        function displayCertificate() {
            console.log("displayCertificate called");
            if (!certificateScreen || !certificateRecipient || !certificateDate) {
                console.error("Certificate screen elements not found!");
                return;
            }
            certificateRecipient.textContent = `${firstName} ${lastName}`;
            certificateDate.textContent = getCurrentDateString();
            showScreen(certificateScreen);
        }

        /**
         * Displays the results screen for a failed quiz attempt, potentially disabling retry.
         */
        function displayFailScreen() {
            console.log(`displayFailScreen called, attemptsToday: ${attemptsToday}`);
            if (!resultsScreen || !resultsTitle || !scoreDisplay || !resultsMessage || !restartTrainingButtonFail) {
                console.error("Results screen elements not found!");
                return;
            }
            resultsTitle.textContent = "Quiz Results";
            scoreDisplay.innerHTML = `
                User: <span class="font-bold">${firstName} ${lastName}</span> (ID: ${xlcId})<br>
                Score: <span class="font-bold">${score} / ${currentShuffledQuestions.length}</span><br>
                Percentage: <span class="font-bold text-red-600">${percentage}%</span><br>
                Status: <span class="font-bold text-red-600">Fail</span> (Required: ${PASSING_PERCENTAGE}%)
            `;

            // Check if the user has reached the attempt limit
            if (attemptsToday >= MAX_ATTEMPTS_PER_DAY) {
                resultsMessage.textContent = `You did not meet the required score and have reached the maximum of ${MAX_ATTEMPTS_PER_DAY} attempts for today. Please try again later.`;
                restartTrainingButtonFail.disabled = true; // Disable the restart button
                restartTrainingButtonFail.title = `Maximum attempts reached. Try again after ${ATTEMPT_WINDOW_HOURS} hours.`; // Add tooltip
            } else {
                const remainingAttempts = MAX_ATTEMPTS_PER_DAY - attemptsToday;
                resultsMessage.textContent = `You did not meet the required score of ${PASSING_PERCENTAGE}%. Please review the training material carefully. You have ${remainingAttempts} attempt(s) remaining today.`;
                restartTrainingButtonFail.disabled = false; // Ensure restart button is enabled
                 restartTrainingButtonFail.title = ''; // Clear tooltip
            }

            showScreen(resultsScreen);
        }

        /**
         * Logs the quiz result data to the Firestore database.
         * @returns {Promise<firebase.firestore.DocumentReference | void>} A promise that resolves with the document reference on success, or rejects on error.
         */
        function logQuizResult() {
            console.log("logQuizResult called");
            return new Promise((resolve, reject) => {
                if (typeof firestoreDb === 'undefined' || !firestoreDb) {
                    const errorMsg = "Firestore not initialized! Cannot log results.";
                    console.error(errorMsg);
                    reject(new Error(errorMsg));
                    return;
                }

                const { date, time } = getCurrentDateTime();
                const resultData = {
                    quizDate: date,
                    quizTime: time,
                    firstName: firstName,
                    lastName: lastName,
                    xlcId: xlcId,
                    quizScore: score,
                    quizPercentage: percentage,
                    passFail: passStatus,
                    incorrectQuestions: incorrectQuestions,
                    timestamp: firebase.firestore.FieldValue.serverTimestamp() // Crucial for time-based query
                };

                console.log("Adding document to Firestore collection 'quizResults':", resultData);
                firestoreDb.collection("quizResults").add(resultData)
                    .then((docRef) => {
                        console.log("Document written with ID: ", docRef.id);
                        resolve(docRef);
                    })
                    .catch((error) => {
                        console.error("Error adding document to Firestore: ", error);
                        reject(error);
                    });
            });
        }

        /**
         * Resets the application state and returns to the welcome screen.
         */
        function restartTraining() {
            console.log("restartTraining called");
            // Clear input fields
            if (firstNameInput) firstNameInput.value = '';
            if (lastNameInput) lastNameInput.value = '';
            if (xlcIdInput) xlcIdInput.value = '';
            // Reset state variables
            firstName = '';
            lastName = '';
            xlcId = '';
            currentStep = 0;
            currentQuestionIndex = 0;
            userAnswers = [];
            score = 0;
            percentage = 0;
            passStatus = '';
            currentShuffledQuestions = [];
            incorrectQuestions = [];
            attemptsToday = 0; // Reset attempt counter for UI state
            // Ensure buttons are re-enabled
            if (startTrainingButton) startTrainingButton.disabled = false;
            if (restartTrainingButtonFail) restartTrainingButtonFail.disabled = false;
            // Show the welcome screen
            if (welcomeScreen) showScreen(welcomeScreen);
        }

        // --- Initial Setup ---

        /**
         * Checks if all essential DOM elements are present.
         * @returns {boolean} True if all elements are found, false otherwise.
         */
        function initializeApp() {
            const essentialElements = [
                welcomeScreen, firstNameInput, lastNameInput, xlcIdInput, startTrainingButton, // Added start button check
                trainingContainer, stepContent, prevButton, nextButton, quizButton, stepIndicator,
                quizContainer, quizQuestionDiv, nextQuestionButton, submitQuizButton,
                resultsScreen, resultsTitle, scoreDisplay, resultsMessage, resultsActions, downloadCsvButton, restartTrainingButtonFail, // Added fail restart button check
                certificateScreen, certificateRecipient, certificateDate, downloadCsvButtonCert,
                messageBox, messageText
            ];

            const missingElement = essentialElements.find(el => !el);

            if (missingElement) {
                const missingId = essentialElements.reduce((acc, el, index) => {
                    if (!el && !acc) {
                        const ids = [
                            'welcome-screen', 'firstName', 'lastName', 'xlcId', 'start-training-button',
                            'training-container', 'step-content', 'prev-button', 'next-button', 'quiz-button', 'step-indicator',
                            'quiz-container', 'quiz-question', 'next-question-button', 'submit-quiz-button',
                            'results-screen', 'results-title', 'score-display', 'results-message', 'results-actions', 'download-csv-button', 'restart-training-button-fail',
                            'certificate-screen', 'certificate-recipient', 'certificate-date', 'download-csv-button-cert',
                            'message-box', 'message-text'
                        ];
                        return ids[index] || 'Unknown Element';
                    }
                    return acc;
                }, null);

                console.error(`Initialization failed: Element with ID '${missingId || 'Unknown'}' not found.`);
                document.body.innerHTML = `<p style="color: red; text-align: center; padding: 20px;">Error: App could not initialize. A required element ('${missingId || 'Unknown'}') is missing.</p>`;
                return false;
            }

            console.log("All essential application elements found.");
            return true;
        }

        // --- Event Listener for DOMContentLoaded ---
        document.addEventListener('DOMContentLoaded', (event) => {
            console.log("DOM fully loaded and parsed");
            if (typeof firestoreDb !== 'undefined' && initializeApp()) {
                console.log("App initialized successfully.");
                showScreen(welcomeScreen);
            } else if (typeof firestoreDb === 'undefined') {
                console.error("Firestore DB was not initialized. App cannot fully function.");
                if (messageText && messageBox && initializeApp()) {
                     showMessage("Error: Cannot connect to the database service. Attempt limits cannot be checked and results logging will be unavailable.");
                     showScreen(welcomeScreen);
                } else if (!initializeApp()){
                    console.error("Cannot show welcome screen due to missing elements.")
                } else {
                    alert("Error: Cannot connect to the database service. Attempt limits cannot be checked and results logging will be unavailable.");
                    showScreen(welcomeScreen);
                }
            } else {
                console.error("App initialization failed due to missing DOM elements.");
            }
        });

    </script>

