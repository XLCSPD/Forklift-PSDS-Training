        function getCurrentDateTime() {
            const now = new Date();
            const date = now.toLocaleDateString('en-CA'); // YYYY-MM-DD format
            const time = now.toLocaleTimeString('en-US', { hour12: false }); // HH:MM:SS format
            return { date, time };
        }

