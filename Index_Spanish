                 select_final_answer: "Por favor, seleccione una respuesta para la última pregunta.",
                 attempt_limit_reached: `Ha alcanzado el máximo de ${MAX_ATTEMPTS_PER_DAY} intentos permitidos en un período de ${ATTEMPT_WINDOW_HOURS} horas. Por favor, inténtelo de nuevo más tarde.`,
                 attempt_check_error: "Error al verificar sus intentos anteriores. Por favor, inténtelo de nuevo.",
                 db_connection_error: "Error: No se puede conectar a la base de datos para verificar intentos. Por favor, inténtelo de nuevo más tarde.",
                 index_error: `Configuración de base de datos necesaria. Pida al administrador que cree el índice requerido en Firestore para la verificación de intentos. Detalles: ${substitutions.details || ''}`,
                 load_training_error: "Error: No se pudieron cargar los pasos del entrenamiento.",
                 load_quiz_error: "Error: No se pudo iniciar la prueba.",
                 submit_error: "Ocurrió un error inesperado al enviar la prueba.",
                 generate_cert_error: "No se pudo generar la imagen del certificado.",
                 download_lib_error: "La biblioteca de descarga del certificado o el elemento no se encontraron.",
                 csv_unsupported: "La descarga de CSV no es compatible con su navegador.",
                 log_results_error: "No se pudieron guardar los resultados en la base de datos, pero se muestra su resultado.",
                 log_results_success: "Resultados de la prueba guardados.", // Optional: can be shown if needed
                 firestore_init_error: "Error Crítico: No se pudo conectar a los servicios requeridos.",
                 firestore_init_fail_log: "Error: No se puede conectar al servicio de base de datos. El registro de resultados no estará disponible.",
                 element_missing_error: `Error: La aplicación no pudo inicializarse. Falta un elemento requerido ('${substitutions.elementId || 'Desconocido'}').`

             };

             let finalMessage = messages[messageKey] || messageKey; // Use the key itself as fallback

             if(messageText && messageBox){
                 messageText.textContent = finalMessage;
                 messageBox.classList.remove('hidden');
             } else {
                 console.error("Message box elements not found");
                 alert(finalMessage);
             }
        }


        function closeMessageBox() {
            if(messageBox) messageBox.classList.add('hidden');
        }

        function downloadCertificate() {
            const certificateElement = document.getElementById('certificate-screen').querySelector('.certificate');
            if (typeof html2canvas !== 'undefined' && html2canvas && certificateElement) {
                html2canvas(certificateElement, {
                    scale: 2, useCORS: true, backgroundColor: '#fefce8'
                }).then(canvas => {
                    const link = document.createElement('a');
                    // Keep filename structure, maybe add _ES
                    link.download = `Certificado_Montacargas_${firstName}_${lastName}.png`;
                    link.href = canvas.toDataURL('image/png');
                    link.click();
                }).catch(err => {
                    console.error("Error generating certificate image:", err);
                    showMessage('generate_cert_error');
                });
            } else {
                showMessage('download_lib_error');
            }
        }

        function downloadResults() {
            const { date, time } = getCurrentDateTime();
            // Keep CSV headers in English for database/processing consistency
            const csvHeader = "QuizDate,QuizTime,FirstName,LastName,XLC_ID,Score,TotalQuestions,Percentage,PassFail,IncorrectQuestions\n";
            const escapeCSV = (field) => `"${String(field).replace(/"/g, '""')}"`;
            const safeFirstName = escapeCSV(firstName);
            const safeLastName = escapeCSV(lastName);
            const safeXlcId = escapeCSV(xlcId);
            // Translate Pass/Fail status for the CSV data if desired, or keep English
            const translatedPassStatus = passStatus === 'Pass' ? 'Aprobado' : 'Falló';
            const incorrectQuestionsStr = escapeCSV(incorrectQuestions.join('; ')); // Questions themselves are already translated
            // Using translatedPassStatus in the data row
            const csvData = `${escapeCSV(date)},${escapeCSV(time)},${safeFirstName},${safeLastName},${safeXlcId},${score},${currentShuffledQuestions.length},${percentage},${escapeCSV(translatedPassStatus)},${incorrectQuestionsStr}\n`;
            const csvContent = csvHeader + csvData;
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            if (link.download !== undefined) {
                const url = URL.createObjectURL(blob);
                link.setAttribute("href", url);
                const dateStr = date;
                 // Keep filename structure, maybe add _ES
                link.setAttribute("download", `Resultado_Prueba_Montacargas_${xlcId}_${dateStr}.csv`);
                link.style.visibility = 'hidden';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(url);
            } else {
                showMessage('csv_unsupported');
            }
        }


        // --- Core Logic Functions (Logic remains the same, messages translated via showMessage) ---

        async function startTraining() {
            console.log("startTraining called");
            if (startTrainingButton) startTrainingButton.disabled = true;

            if (!firstNameInput || !lastNameInput || !xlcIdInput) {
                showMessage('input_error');
                console.error("Input elements missing in startTraining");
                 if (startTrainingButton) startTrainingButton.disabled = false;
                return;
            }

            const fname = firstNameInput.value.trim();
            const lname = lastNameInput.value.trim();
            const id = xlcIdInput.value.trim();

            if (!fname || !lname || !id) {
                showMessage('fill_fields');
                 if (startTrainingButton) startTrainingButton.disabled = false;
                return;
            }

            firstName = fname;
            lastName = lname;
            xlcId = id;

            if (typeof firestoreDb === 'undefined' || !firestoreDb) {
                showMessage('db_connection_error');
                console.error("Firestore not initialized in startTraining");
                 if (startTrainingButton) startTrainingButton.disabled = false;
                return;
            }

            const timeLimit = getTimestampHoursAgo(ATTEMPT_WINDOW_HOURS);
            console.log(`Checking attempts for XLC_ID: ${xlcId} since ${timeLimit.toDate()}`);

            try {
                const querySnapshot = await firestoreDb.collection("quizResults")
                    .where("xlcId", "==", xlcId)
                    .where("timestamp", ">=", timeLimit)
                    .get();

                attemptsToday = querySnapshot.size;
                console.log(`Found ${attemptsToday} attempts in the last ${ATTEMPT_WINDOW_HOURS} hours.`);

                if (attemptsToday >= MAX_ATTEMPTS_PER_DAY) {
                    showMessage('attempt_limit_reached');
                    if (startTrainingButton) startTrainingButton.disabled = false;
                    return;
                }

                currentStep = 0;
                console.log("User details set and attempt limit checked:", firstName, lastName, xlcId);

                const targetScreen = document.getElementById('training-container');
                if(targetScreen){
                    console.log("Attempting to show training container...");
                    showScreen(targetScreen);
                    displayStep(currentStep);
                } else {
                    console.error("Training container element not found!");
                    showMessage('load_training_error');
                }

            } catch (error) {
                console.error("Error checking quiz attempts:", error);
                if (error.message && error.message.includes("indexes?")) {
                     showMessage('index_error', { details: error.message });
                } else {
                    showMessage('attempt_check_error');
                }
                if (startTrainingButton) startTrainingButton.disabled = false;
                return;
            }
             if (startTrainingButton) startTrainingButton.disabled = false;
        }

        function displayStep(stepIndex) {
             if (stepIndex < 0 || stepIndex >= trainingSteps.length) return;
             if (!stepContent) { console.error("stepContent element not found!"); return; }

             const step = trainingSteps[stepIndex];
             if (!step || !step.title || !step.description || typeof step.scannerContent === 'undefined') {
                 console.error("Invalid step data for index:", stepIndex, step);
                 stepContent.innerHTML = '<p class="text-red-500">Error al cargar el contenido del paso.</p>'; // Error message in Spanish
                 return;
             }
            // Indicator text updated for Spanish ("Paso")
             stepIndicator.textContent = `Paso ${stepIndex + 1} / ${trainingSteps.length}`;
             prevButton.disabled = stepIndex === 0;
             prevButton.classList.toggle('opacity-50', stepIndex === 0);
             prevButton.classList.toggle('cursor-not-allowed', stepIndex === 0);

             if (stepIndex === trainingSteps.length - 1) {
                 nextButton.classList.add('hidden');
                 quizButton.classList.remove('hidden');
             } else {
                 nextButton.classList.remove('hidden');
                 quizButton.classList.add('hidden');
             }

             stepContent.classList.remove('fade-in');
             void stepContent.offsetWidth;
             stepContent.classList.add('fade-in');
             // Use translated title and description, keep scannerContent English
             stepContent.innerHTML = `
                <h2 class="text-xl md:text-2xl font-bold text-gray-800 mb-3">${step.title}</h2>
                <p class="text-gray-600 mb-4 whitespace-pre-line">${step.description}</p>
                <div class="scanner-screen">${step.scannerContent.trim()}</div>
             `;
        }

        function nextStep() {
            console.log("nextStep called");
            if (currentStep < trainingSteps.length - 1) {
                currentStep++;
                displayStep(currentStep);
            }
        }

        function prevStep() {
            console.log("prevStep called");
            if (currentStep > 0) {
                currentStep--;
                displayStep(currentStep);
            }
        }

        function startQuiz() {
            console.log("startQuiz called");
            currentShuffledQuestions = shuffleArray(originalQuizQuestions); // Use translated questions
            currentQuestionIndex = 0;
            userAnswers = new Array(currentShuffledQuestions.length).fill(null);
            incorrectQuestions = [];
            score = 0;
            percentage = 0;
            passStatus = '';

            const targetScreen = document.getElementById('quiz-container');
            if (targetScreen) {
                 showScreen(targetScreen);
                 displayQuestion(currentQuestionIndex);
                 if(submitQuizButton) submitQuizButton.classList.add('hidden');
                 if(nextQuestionButton) nextQuestionButton.classList.remove('hidden');
            } else {
                 console.error("Quiz container element not found!");
                 showMessage('load_quiz_error');
            }
        }

        function displayQuestion(index) {
            if (index < 0 || index >= currentShuffledQuestions.length) return;
            if (!quizQuestionDiv) { console.error("quizQuestionDiv element not found!"); return; }

            const q = currentShuffledQuestions[index]; // Will be the translated question object
            if (!q || !q.question || !Array.isArray(q.options)) {
                console.error("Invalid question data for index:", index, q);
                quizQuestionDiv.innerHTML = '<p class="text-red-500">Error al cargar la pregunta.</p>'; // Error in Spanish
                return;
            }
            // Question number included
            let optionsHtml = `<p class="text-lg font-semibold mb-4">${index + 1}. ${q.question}</p><div class="space-y-3">`;
            q.options.forEach((option) => { // Options are already translated
                const escapedOption = String(option).replace(/'/g, "\\'");
                const isSelected = userAnswers[index] === option;
                optionsHtml += `
                    <div
                        class="quiz-option border-2 border-gray-300 rounded-lg p-3 hover:bg-gray-100 ${isSelected ? 'selected' : ''}"
                        onclick="selectAnswer(${index}, '${escapedOption}')">
                        ${option}
                    </div>
                `;
            });
            optionsHtml += '</div>';
            quizQuestionDiv.innerHTML = optionsHtml;

            if(index === currentShuffledQuestions.length - 1) {
                 if(nextQuestionButton) nextQuestionButton.classList.add('hidden');
                 if(submitQuizButton) submitQuizButton.classList.remove('hidden');
            } else {
                 if(nextQuestionButton) nextQuestionButton.classList.remove('hidden');
                 if(submitQuizButton) submitQuizButton.classList.add('hidden');
            }

            quizQuestionDiv.classList.remove('fade-in');
            void quizQuestionDiv.offsetWidth;
            quizQuestionDiv.classList.add('fade-in');
        }

        function selectAnswer(questionIndex, answer) {
            userAnswers[questionIndex] = answer;
            displayQuestion(questionIndex);
        }

        function nextQuestion() {
            if (userAnswers[currentQuestionIndex] === null) {
                showMessage('select_answer');
                return;
            }
            if (currentQuestionIndex < currentShuffledQuestions.length - 1) {
                currentQuestionIndex++;
                displayQuestion(currentQuestionIndex);
            }
        }

        function submitQuiz() {
            console.log("submitQuiz called");
            if (!submitQuizButton) { console.error("Submit button not found"); return; }

            submitQuizButton.disabled = true;
            // Button text in Spanish
            submitQuizButton.textContent = 'Enviando...';

            try {
                if (userAnswers[currentQuestionIndex] === null) {
                    showMessage('select_final_answer');
                    submitQuizButton.disabled = false;
                    submitQuizButton.textContent = 'Enviar Respuestas'; // Reset text
                    return;
                }

                score = 0;
                incorrectQuestions = [];
                userAnswers.forEach((answer, index) => {
                    if (currentShuffledQuestions[index]) {
                         // Comparison uses the translated correctAnswer from the question object
                        if (answer === currentShuffledQuestions[index].correctAnswer) {
                            score++;
                        } else if (currentShuffledQuestions[index].question) {
                            incorrectQuestions.push(currentShuffledQuestions[index].question); // Store the translated question text
                        }
                    } else {
                        console.warn("Issue comparing answer for question index:", index, "- Question data missing.");
                    }
                });

                percentage = currentShuffledQuestions.length > 0 ? Math.round((score / currentShuffledQuestions.length) * 100) : 0;
                // Keep internal status English, translate for display only
                passStatus = percentage >= PASSING_PERCENTAGE ? 'Pass' : 'Fail';
                attemptsToday++;

                console.log(`Quiz submitted: Score=${score}, Percentage=${percentage}, Status=${passStatus}, Attempt# ${attemptsToday}`);

                logQuizResult()
                    .then(() => {
                        console.log("logQuizResult finished successfully.");
                        if (passStatus === 'Pass') {
                            displayCertificate();
                        } else {
                            displayFailScreen();
                        }
                    })
                    .catch(error => {
                        console.error("Error logging result to Firestore:", error);
                         showMessage('log_results_error');
                        if (passStatus === 'Pass') {
                            displayCertificate();
                        } else {
                            displayFailScreen();
                        }
                    })
                    .finally(() => {
                        submitQuizButton.disabled = false;
                        submitQuizButton.textContent = 'Enviar Respuestas'; // Reset text
                    });

            } catch (error) {
                console.error("Error occurred in submitQuiz function:", error);
                showMessage('submit_error');
                submitQuizButton.disabled = false;
                submitQuizButton.textContent = 'Enviar Respuestas'; // Reset text
            }
        }


        function displayCertificate() {
            console.log("displayCertificate called");
            if (!certificateScreen || !certificateRecipient || !certificateDate) {
                console.error("Certificate screen elements not found!");
                return;
            }
            certificateRecipient.textContent = `${firstName} ${lastName}`;
            certificateDate.textContent = getCurrentDateString(); // Use Spanish date format
            showScreen(certificateScreen);
        }

        function displayFailScreen() {
            console.log(`displayFailScreen called, attemptsToday: ${attemptsToday}`);
            if (!resultsScreen || !resultsTitle || !scoreDisplay || !resultsMessage || !restartTrainingButtonFail) {
                console.error("Results screen elements not found!");
                return;
            }
            // Title translated
            resultsTitle.textContent = "Resultados de la Prueba";
            // Labels translated, status translated
            const displayStatus = passStatus === 'Pass' ? 'Aprobado' : 'Falló';
            scoreDisplay.innerHTML = `
                Usuario: <span class="font-bold">${firstName} ${lastName}</span> (ID: ${xlcId})<br>
                Puntuación: <span class="font-bold">${score} / ${currentShuffledQuestions.length}</span><br>
                Porcentaje: <span class="font-bold text-red-600">${percentage}%</span><br>
                Estado: <span class="font-bold text-red-600">${displayStatus}</span> (Requerido: ${PASSING_PERCENTAGE}%)
            `;

            if (attemptsToday >= MAX_ATTEMPTS_PER_DAY) {
                resultsMessage.textContent = `No alcanzó la puntuación requerida y ha llegado al máximo de ${MAX_ATTEMPTS_PER_DAY} intentos por hoy. Por favor, inténtelo de nuevo más tarde.`;
                restartTrainingButtonFail.disabled = true;
                // Tooltip in Spanish
                restartTrainingButtonFail.title = `Máximo de intentos alcanzado. Intente de nuevo después de ${ATTEMPT_WINDOW_HOURS} horas.`;
            } else {
                const remainingAttempts = MAX_ATTEMPTS_PER_DAY - attemptsToday;
                // Message in Spanish
                resultsMessage.textContent = `No alcanzó la puntuación requerida de ${PASSING_PERCENTAGE}%. Por favor, revise el material de entrenamiento cuidadosamente. Le queda(n) ${remainingAttempts} intento(s) hoy.`;
                restartTrainingButtonFail.disabled = false;
                 restartTrainingButtonFail.title = '';
            }

            showScreen(resultsScreen);
        }

        // logQuizResult remains the same - sends English field names to Firestore
        function logQuizResult() {
            console.log("logQuizResult called");
            return new Promise((resolve, reject) => {
                if (typeof firestoreDb === 'undefined' || !firestoreDb) {
                    const errorMsg = "Firestore not initialized! Cannot log results.";
                    console.error(errorMsg);
                    reject(new Error(errorMsg));
                    return;
                }
                const { date, time } = getCurrentDateTime();
                const resultData = {
                    quizDate: date, quizTime: time, firstName: firstName, lastName: lastName, xlcId: xlcId,
                    quizScore: score, quizPercentage: percentage, passFail: passStatus, // Keep Pass/Fail English internally
                    incorrectQuestions: incorrectQuestions, // These question strings are already translated
                    timestamp: firebase.firestore.FieldValue.serverTimestamp()
                };
                console.log("Adding document to Firestore collection 'quizResults':", resultData);
                firestoreDb.collection("quizResults").add(resultData)
                    .then((docRef) => {
                        console.log("Document written with ID: ", docRef.id);
                        resolve(docRef);
                    })
                    .catch((error) => {
                        console.error("Error adding document to Firestore: ", error);
                        reject(error); // Reject the promise for submitQuiz to handle
                    });
            });
        }

        function restartTraining() {
            console.log("restartTraining called");
            if (firstNameInput) firstNameInput.value = '';
            if (lastNameInput) lastNameInput.value = '';
            if (xlcIdInput) xlcIdInput.value = '';
            firstName = ''; lastName = ''; xlcId = '';
            currentStep = 0; currentQuestionIndex = 0;
            userAnswers = []; score = 0; percentage = 0; passStatus = '';
            currentShuffledQuestions = []; incorrectQuestions = [];
            attemptsToday = 0;
            if (startTrainingButton) startTrainingButton.disabled = false;
            if (restartTrainingButtonFail) restartTrainingButtonFail.disabled = false;
            if (welcomeScreen) showScreen(welcomeScreen);
        }

        // --- Initial Setup (Logic remains same, uses translated messages) ---
        function initializeApp() {
            const essentialElements = [
                welcomeScreen, firstNameInput, lastNameInput, xlcIdInput, startTrainingButton,
                trainingContainer, stepContent, prevButton, nextButton, quizButton, stepIndicator,
                quizContainer, quizQuestionDiv, nextQuestionButton, submitQuizButton,
                resultsScreen, resultsTitle, scoreDisplay, resultsMessage, resultsActions, downloadCsvButton, restartTrainingButtonFail,
                certificateScreen, certificateRecipient, certificateDate, downloadCsvButtonCert,
                messageBox, messageText
            ];
            const missingElement = essentialElements.find(el => !el);
            if (missingElement) {
                const missingId = essentialElements.reduce((acc, el, index) => {
                    if (!el && !acc) {
                        const ids = [
                            'welcome-screen', 'firstName', 'lastName', 'xlcId', 'start-training-button',
                            'training-container', 'step-content', 'prev-button', 'next-button', 'quiz-button', 'step-indicator',
                            'quiz-container', 'quiz-question', 'next-question-button', 'submit-quiz-button',
                            'results-screen', 'results-title', 'score-display', 'results-message', 'results-actions', 'download-csv-button', 'restart-training-button-fail',
                            'certificate-screen', 'certificate-recipient', 'certificate-date', 'download-csv-button-cert',
                            'message-box', 'message-text'
                        ];
                        return ids[index] || 'Unknown Element';
                    }
                    return acc;
                }, null);
                console.error(`Initialization failed: Element with ID '${missingId || 'Unknown'}' not found.`);
                 // Show error using the message function if possible, otherwise raw HTML
                 if (typeof showMessage === 'function') {
                    showMessage('element_missing_error', { elementId: missingId });
                 } else {
                    document.body.innerHTML = `<p style="color: red; text-align: center; padding: 20px;">Error: La aplicación no pudo inicializarse. Falta un elemento requerido ('${missingId || 'Desconocido'}').</p>`;
                 }
                return false;
            }
            console.log("All essential application elements found.");
            return true;
        }

        document.addEventListener('DOMContentLoaded', (event) => {
            console.log("DOM fully loaded and parsed");
            if (typeof firestoreDb !== 'undefined' && initializeApp()) {
                console.log("App initialized successfully.");
                showScreen(welcomeScreen);
            } else if (typeof firestoreDb === 'undefined') {
                console.error("Firestore DB was not initialized. App cannot fully function.");
                if (initializeApp()) { // Check elements before showing message
                    showMessage('firestore_init_fail_log');
                    showScreen(welcomeScreen); // Still show welcome screen
                } else {
                     console.error("Cannot show welcome screen due to missing elements.")
                }
            } else {
                console.error("App initialization failed due to missing DOM elements.");
                 // initializeApp already displayed an error message
            }
        });

    </script>

</body>
