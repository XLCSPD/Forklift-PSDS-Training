        // --- Helper Functions (remain the same, except for locale in date string if needed) ---

        function shuffleArray(array) {
            let currentIndex = array.length, randomIndex;
            const newArray = [...array];
            while (currentIndex !== 0) {
                randomIndex = Math.floor(Math.random() * currentIndex);
                currentIndex--;
                [newArray[currentIndex], newArray[randomIndex]] = [
                    newArray[randomIndex], newArray[currentIndex]];
            }
            return newArray;
        }

        // Using 'es-DO' for Dominican Republic Spanish date format, fallback 'es'
        function getCurrentDateString(format = 'es-DO') {
            const options = { year: 'numeric', month: 'long', day: 'numeric' };
            try {
                 return new Date().toLocaleDateString(format, options);
            } catch (e) {
                 // Fallback to generic Spanish if locale is not supported
                 console.warn(`Locale ${format} not supported, falling back to 'es'.`);
                 return new Date().toLocaleDateString('es', options);
            }
        }

        function getCurrentDateTime() {
            const now = new Date();
            const date = now.toLocaleDateString('en-CA'); // Keep YYYY-MM-DD for consistency in DB/CSV
            const time = now.toLocaleTimeString('en-US', { hour12: false }); // Keep HH:MM:SS
            return { date, time };
        }

        function getTimestampHoursAgo(hoursAgo) {
            const date = new Date();
            date.setHours(date.getHours() - hoursAgo);
            return firebase.firestore.Timestamp.fromDate(date);
