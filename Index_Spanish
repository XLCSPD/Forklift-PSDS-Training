      .certificate .subtitle { font-size: 1.1rem; font-weight: 600; color: #ca8a04; /* Dark yellow */ margin-bottom: 2rem; text-transform: uppercase; }
      .certificate .recipient-name { font-size: 2rem; font-weight: bold; color: #1f2937; margin-bottom: 1rem; border-bottom: 2px solid #facc15; display: inline-block; padding-bottom: 0.5rem; }
      .certificate .acknowledgment { font-size: 0.9rem; color: #4b5563; /* Medium gray */ margin-bottom: 2.5rem; }
      .certificate .footer { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 2rem; }
      .certificate .date { font-size: 0.9rem; color: #4b5563; }
      /* Decorative corner elements for certificate */
      .certificate::before, .certificate::after { content: ''; position: absolute; width: 50px; height: 50px; background-color: #f3f4f6; /* Light gray background */ border-radius: 50%; z-index: -1; }
      .certificate::before { top: -25px; left: -25px; }
      .certificate::after { top: -25px; right: -25px; }

