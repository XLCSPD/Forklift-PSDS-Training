      .certificate { border: 10px solid #facc15; /* Yellow border */ background-color: #fefce8; /* Light yellow background */ padding: 2rem 3rem; text-align: center; max-width: 600px; margin: auto; position: relative; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
